#include<iostream>
#include<stack>
using namespace std;

void addAtBottom(stack<int>&st, int x) {
    stack<int> temp;
    while (!st.empty()) {
        temp.push(st.top());
        st.pop();
    }
    st.push(x);
    while (!temp.empty()) {
        st.push(temp.top());
        temp.pop();
    }
}

void showElements(stack<int> st) {  // Pass by value to avoid modifying the original stack
    while (!st.empty()) {
        cout << st.top() << " ";
        st.pop();
    }
    cout << endl;
}

int main() {
    stack<int> st;
    st.push(1);
    st.push(2);
    st.push(3);
    st.push(4);

    cout << "Original stack: ";
    showElements(st);  // Print stack before modification

    cout << "After adding the element at the bottom: " << endl;
    addAtBottom(st, 5);

    cout << "Modified stack: ";
    showElements(st);
}
